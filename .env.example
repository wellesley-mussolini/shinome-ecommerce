# Copie para .env.local (dev) e preencha com os dados do projeto Supabase:
#   Supabase Dashboard > Project Settings > API
#
# Só variáveis com prefixo VITE_ chegam ao navegador. Por isso, aqui entram
# SOMENTE chaves públicas. Nunca coloque a service_role / secret key: este
# projeto não tem backend, e tudo o que está aqui fica visível no bundle.
# A segurança dos dados vem das políticas de RLS no Supabase.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-ou-anon-key>
